# ========================================
# Name: Guilherme Armin Da Silva Anton
# UFID: 2641-9801
# COP3530 Project 2 - GeoPulse
# File: .clang-tidy
# Purpose: Defines optional local static-analysis checks.
# ========================================
---
# Disabled checks are intentional:
# -modernize-use-trailing-return-type: ordinary returns are clearer for C++14.
# -modernize-use-nodiscard: nodiscard is not part of this assignment style.
# -modernize-use-auto: explicit types help beginning C++ readers.
# -modernize-avoid-c-arrays: argc/argv are required by standard main.
# -readability-magic-numbers: constants and tests intentionally use values.
# -readability-identifier-length: x, y, id, and i are clear in context.
# -readability-function-cognitive-complexity: files are split by role.
# -bugprone-easily-swappable-parameters: coordinate pairs need adjacent doubles.
Checks: >
    clang-analyzer-*,
    bugprone-*,
    performance-*,
    readability-*,
    -modernize-*,
    -modernize-use-trailing-return-type,
    -modernize-use-nodiscard,
    -modernize-use-auto,
    -modernize-avoid-c-arrays,
    -readability-magic-numbers,
    -readability-identifier-length,
    -readability-function-cognitive-complexity,
    -bugprone-easily-swappable-parameters,
    -readability-redundant-*
WarningsAsErrors: ''
HeaderFilterRegex: '^(include|src)/.*'
FormatStyle: file
CheckOptions:
    - key: readability-identifier-naming.ClassCase
      value: CamelCase
    - key: readability-identifier-naming.StructCase
      value: CamelCase
    - key: readability-identifier-naming.FunctionCase
      value: camelBack
    - key: readability-identifier-naming.VariableCase
      value: camelBack
    - key: readability-identifier-naming.PrivateMemberPrefix
      value: _
    - key: readability-identifier-naming.PrivateMethodPrefix
      value: _
...
